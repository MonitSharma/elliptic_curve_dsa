+#[test]
+fn compact_restoring_step_exhaustive() {
+    let mut total = 0usize;
+    for k in 2..=8 {
+        let mut b = builder();
+        let r = b.alloc_n(k);
+        let d = b.alloc_n(k);
+        let f = b.alloc();
+        let mut after = r.clone();
+        let high = after.pop().unwrap(); after.insert(0, high);
+        let gate = rec(&mut b, |b| {
+            b.cx(r[k - 1], f); b.cx(f, after[0]);
+            super::frogdrop::cmp_csub_carries_vh1(b, &after[1..], &d[1..k - 1], after[0], f);
+            b.x(after[0]); b.cx(f, after[0]); b.cx(after[0], f); b.x(f);
+        });
+        let forward = emitted(&mut b, &gate, false);
+        let reverse = emitted(&mut b, &gate, true);
+        let cases: Vec<_> = (1usize << (k - 1)..1usize << k).filter(|d| d & 1 == 1)
+            .flat_map(|d| (0..d).map(move |r| (d, r))).collect();
+        for chunk in cases.chunks(64) {
+            let mut input = vec![0u64; b.width() as usize];
+            for (lane, &(dv, rv)) in chunk.iter().enumerate() {
+                put(&mut input, &r, lane, N::from(rv as u64));
+                put(&mut input, &d, lane, N::from(dv as u64));
+            }
+            let got = run(&forward, input.len(), &|q| *q = input.clone());
+            for (lane, &(dv, rv)) in chunk.iter().enumerate() {
+                assert_eq!(get(&got.q, &after, lane), N::from(((2*rv + 1) % dv) as u64),
+                           "k={k} d={dv} r={rv}");
+                assert_eq!((got.q[f.0 as usize] >> lane) & 1, 0);
+                assert_eq!(get(&got.q, &d, lane), N::from(dv as u64));
+            }
+            assert_eq!(got.phase, 0);
+            let back = run(&reverse, input.len(), &|q| *q = got.q.clone());
+            assert_eq!(back.q, input);
+            assert_eq!(back.phase, 0);
+            total += chunk.len();
+        }
+    }
+    eprintln!("COMPACT_STEP_EXHAUSTIVE cases={total}");
+}
