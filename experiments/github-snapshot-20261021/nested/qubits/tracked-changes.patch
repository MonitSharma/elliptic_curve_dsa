+/// Compare/subtract with a virtual leading-one source bit (no high zero).
+/// The incoming `out` may hold a saved overflow bit. It is XORed with
+/// the comparison, then controls the subtraction modulo the target width.
+pub fn cmp_csub_carries_vh1(b: &mut B, t: &[QubitId], s: &[QubitId], c0: QubitId, out: QubitId) {
+    let n = t.len();
+    assert_eq!(n, s.len() + 1);
+    assert!(n > 0);
+    for &q in t { b.x(q); }
+    let up = up_m(b, &t[..n - 1], s, c0, false);
+    let dn = down_m(b, &t[..n - 1], s, c0, Dm::Cond(out), false);
+    b.play(&up, false);
+    let carry = if n == 1 { c0 } else { s[n - 2] };
+    let high = t[n - 1];
+    // Carry of ~T + (1 << (n-1)) + low(S) + c0 is high | carry.
+    b.x(out);
+    b.cx(high, out);
+    b.cx(carry, out);
+    b.ccx(high, carry, out);
+    b.x(carry);
+    b.ccx(out, carry, high);
+    b.x(carry);
+    b.play(&dn, false);
+    for &q in t { b.x(q); }
+}
