+#[test]
+fn compact_n276_k24_vform_values_inverse_dirty_and_measurement_phase() {
+    let mut cases = 0u64;
+    let mut coefficients = 0u64;
+    for helpers in [0usize, 4, 8] {
+        let make = |compact: bool| {
+            let mut b = builder();
+            let ring = b.alloc_n(276);
+            let bank = b.alloc_n(128);
+            let _sy = b.alloc_n(8);
+            let sx = b.alloc_n(8);
+            let _ph = b.alloc();
+            let pool = b.alloc_n(13);
+            let dirty = b.alloc_n(259);
+            assert_eq!(b.width(), 693);
+            let mut remainder = ring[..if compact { 18 } else { 19 }].to_vec();
+            remainder.extend(&sx[1..6]);
+            remainder.push(ring[275]);
+            let s = S1 { r: remainder, f: sx[0], zero: ring[18], sgn: sx[0], gt: vec![sx[0]],
+                anc: vec![], andc: bank[..helpers].to_vec(), chain: bank[..helpers].to_vec(),
+                dirty: dirty.clone() };
+            let stage = if compact { super::midg::stage1_v_compact } else { stage1_v };
+            let fv = stage(&mut b, &ring[252..276], &ring[18..19 + TC], &pool[..8], (57, 256), &s, pool[12], true);
+            let fr = stage(&mut b, &ring[252..276], &ring[18..19 + TC], &pool[..8], (57, 256), &s, pool[12], false);
+            let v = rec(&mut b, |b| {
+                b.x(ring[275]); b.play(&fv, false); b.play(&fr, true); b.x(ring[275]);
+            });
+            let forward = emitted(&mut b, &v, false);
+            let reverse = emitted(&mut b, &v, true);
+            (ring, bank, sx, pool, dirty, forward, reverse)
+        };
+        let (ring, bank, sx, pool, dirty, forward, inverse) = make(true);
+        let (_, _, _, _, _, reference, _) = make(false);
+        let count = |ops: &[Op]| ops.iter().filter(|o| o.kind == K::CCX || o.kind == K::CCZ).count();
+        eprintln!("COMPACT_VFORM_PRICE helpers={helpers} old={} new={} saved={}",
+            count(&reference), count(&forward), count(&reference) as isize - count(&forward) as isize);
+        for seed in [0x2026_1014u64, 0x693_24_cafe] {
+            let mut rng = Rng::new(seed);
+            for mode in 0..4 {
+                let mut input: Vec<_> = (0..693).map(|_| rng.next()).collect();
+                let active = [!0u64, 0, 0xa55a_c33c_0ff0_f00f, 0x00ff_0f0f_3333_5555][mode];
+                input[pool[12].0 as usize] = active;
+                input[sx[0].0 as usize] = 0;
+                for &q in ring[..19].iter().chain(sx[1..6].iter()) { input[q.0 as usize] &= !active; }
+                input[ring[275].0 as usize] |= active;
+                for &q in &bank[..helpers] { input[q.0 as usize] = 0; }
+                for lane in 0..64 {
+                    let size = [57usize, 128, 133, 230, 231, 232, 255, 256][lane % 8];
+                    put(&mut input, &pool[..8], lane, N::from(size as u64));
+                }
+                let want = run(&reference, 693, &|q| *q = input.clone());
+                let got = run(&forward, 693, &|q| *q = input.clone());
+                assert_eq!(want.phase, 0);
+                assert_eq!(got.phase, 0);
+                for (index, (a, z)) in got.q.iter().zip(&want.q).enumerate() {
+                    if a != z {
+                        let lane = (a ^ z).trailing_zeros() as usize;
+                        eprintln!("COMPACT_DIAGNOSTIC lane={lane} size={:?} divisor={:?}",
+                                  get(&input, &pool[..8], lane), get(&input, &ring[252..276], lane));
+                    }
+                    assert_eq!(a, z, "wire={index} diff={:#x} helpers={helpers} seed={seed} mode={mode}", a ^ z);
+                }
+                let (sym, n) = symbolic(&forward, input.clone());
+                assert_eq!(sym, got.q);
+                coefficients += n;
+                let back = run(&inverse, 693, &|q| *q = got.q.clone());
+                assert_eq!(back.phase, 0);
+                assert_eq!(back.q, input);
+                let (sym, n) = symbolic(&inverse, got.q);
+                assert_eq!(sym, input);
+                coefficients += n;
+                // Passenger registers are included in the exact all-wire comparisons.
+                assert_eq!(dirty.len(), 259);
+                cases += 64;
+            }
+        }
+    }
+    eprintln!("COMPACT_N276_PASS cases={cases} independent_measurement_coefficients={coefficients}");
