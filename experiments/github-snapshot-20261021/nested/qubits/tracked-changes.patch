+#[test]
+fn compact_virtual_high_one_exhaustive() {
+    let mut total = 0usize;
+    for n in 1..=7 {
+        let make = |compact: bool| {
+            let mut b = builder();
+            let t = b.alloc_n(n);
+            let s = b.alloc_n(n);
+            let cin = b.alloc();
+            let out = b.alloc();
+            let gate = rec(&mut b, |b| {
+                if compact { super::frogdrop::cmp_csub_carries_vh1(b, &t, &s[..n - 1], cin, out); }
+                else { super::frogdrop::cmp_csub_carries(b, &t, &s, cin, out, &[]); }
+            });
+            let f = emitted(&mut b, &gate, false);
+            let r = emitted(&mut b, &gate, true);
+            (t, s, cin, out, b.width() as usize, f, r)
+        };
+        let (t, s, cin, out, width, f, r) = make(true);
+        let (_, _, _, _, _, reference, _) = make(false);
+        let cases: Vec<_> = (0..1usize << n).flat_map(|tv|
+            (1usize << (n - 1)..1usize << n).flat_map(move |sv|
+                (0..4).map(move |flags| (tv, sv, flags)))).collect();
+        for chunk in cases.chunks(64) {
+            let mut input = vec![0u64; width];
+            for (lane, &(tv, sv, flags)) in chunk.iter().enumerate() {
+                put(&mut input, &t, lane, N::from(tv as u64));
+                put(&mut input, &s, lane, N::from(sv as u64));
+                input[cin.0 as usize] |= ((flags & 1) as u64) << lane;
+                input[out.0 as usize] |= ((flags >> 1) as u64) << lane;
+            }
+            let got = run(&f, width, &|q| *q = input.clone());
+            let want = run(&reference, width, &|q| *q = input.clone());
+            let mask = if chunk.len() == 64 { !0 } else { (1u64 << chunk.len()) - 1 };
+            for (a, b) in got.q.iter().zip(&want.q) { assert_eq!((a ^ b) & mask, 0, "n={n}"); }
+            assert_eq!(got.phase & mask, 0);
+            let back = run(&r, width, &|q| *q = got.q.clone());
+            assert_eq!(back.q, input);
+            assert_eq!(back.phase, 0);
+            total += chunk.len();
+        }
+    }
+    eprintln!("COMPACT_HIGH_ONE_EXHAUSTIVE cases={total}");
+}
