+pub(super)fn run(mut ops:Vec<Op>)->Vec<Op>{bind(&ops,11602990,"5d1ebe1b48a6f75cf9c3cb77e9914aa067f3bf9f644447935552365c485b920f");let end=ops.len()-96;for(bit,pair)in ops[end..].chunks_exact(2).enumerate(){for o in pair{assert_eq!(o.kind,K::X);assert_eq!(o.q_target.0,(1514011998u64>>bit)&1);}}ops.truncate(end);bind(&ops,11602894,"3aeb0f715ec16f60b8bb69fb0938f0a1a16d468141b9e8cfb7829de9a5f24ea8");let(_,nb,_,_)=analyze_ops(ops.iter());let mut ops=rewrite_ops(ops,LEASES,nb as usize);bind(&ops,11603053,"8573ed9269ea3a03a9390478351fe80d30de5140f20df298e59be4431a7a49ae");let(nq,nb,_,_)=analyze_ops(ops.iter());assert!(nq<=1234);eprintln!("PUBLIC_E3_CACHE leases={} nq={} nb={} output_ops={} diagnostic_only=1",LEASES.len(),nq,nb,ops.len());assert!(IDENTITY_NONCE<(1u64<<48));for bit in 0..48{let mut o=Op::empty();o.kind=K::X;o.q_target=QubitId((IDENTITY_NONCE>>bit)&1);o.validate();ops.extend([o,o]);}ops}
