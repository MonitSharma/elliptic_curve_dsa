+
+fn sb_small(w: usize, inverse: bool, garbage: bool) -> Option<&'static SbPat> {
+    if std::env::var("LF_STRIPSMALL").is_ok_and(|v| v == "0") {
+        return None;
+    }
+    match (w, inverse, garbage) {
+        (5, false, false) => Some(&SB_W5_FWD),
+        (5, true, false) => Some(&SB_W5_REV),
+        (5, true, true) => Some(&SB_W5_REVG),
+        (7, false, false) => Some(&SB_W7_FWD),
+        (7, false, true) => Some(&SB_W7_FWDG),
+        (7, true, false) => Some(&SB_W7_REV),
+        (7, true, true) => Some(&SB_W7_REVG),
+        (9, false, false) => Some(&SB_W9_FWD),
+        (9, false, true) => Some(&SB_W9_FWDG),
+        (9, true, false) => Some(&SB_W9_REV),
+        (9, true, true) => Some(&SB_W9_REVG),
+        _ => None,
+    }
+}
