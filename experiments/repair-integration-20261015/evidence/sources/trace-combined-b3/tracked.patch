+#[derive(Default)]
+pub struct PhaseReport {
+    depth: u32,
+    phase_native: usize,
+    phase_expected: f64,
+    total_native: usize,
+    total_expected: f64,
+    peak: u32,
+    peak_op: usize,
+    peak_phase: &'static str,
