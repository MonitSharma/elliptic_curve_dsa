+    fn op(kind:OperationType,a:u64,b:u64,t:u64)->Op {let mut o=Op::empty();o.kind=kind;o.q_control1=QubitId(a);o.q_control2=QubitId(b);o.q_target=QubitId(t);o}
+    #[test]
