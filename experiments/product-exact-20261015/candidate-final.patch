+    struct Word(u64);
+    impl sha3::digest::XofReader for Word {fn read(&mut self,out:&mut [u8]){assert_eq!(out.len(),8);out.copy_from_slice(&self.0.to_le_bytes());}}
+    fn program()->Vec<Op>{
