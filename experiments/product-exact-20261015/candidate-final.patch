+    fn run_case(p:&[Op],q:&[Op],batch:usize,word:u64)->(Vec<u64>,Vec<u64>,Vec<u64>,Vec<u64>,u64,u64,u64,u64){
+        let mut xa=Word(word);let mut xb=Word(word);
