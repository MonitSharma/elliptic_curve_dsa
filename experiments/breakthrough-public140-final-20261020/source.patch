+        if drops.contains(&i){continue;}
+        for &q in &rows[i]{c.cx(q,acc[i]);}if ones[i]{c.x(acc[i]);}if i!=n-1||paused{c.cx(cc[i].unwrap(),acc[i]);}
+        if i>0&&(i<n-1||paused){
