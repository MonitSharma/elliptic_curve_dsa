+    struct Words{data:Vec<u8>,pos:usize}impl XofReader for Words{fn read(&mut self,b:&mut[u8]){let e=self.pos+b.len();assert!(e<=self.data.len());b.copy_from_slice(&self.data[self.pos..e]);self.pos=e;}}
