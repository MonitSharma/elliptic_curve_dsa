+fn phase(c:&mut Builder,q:&[QubitId],terms:&[(usize,usize)]){for &(a,b)in terms{match(a,b){(0,0)=>{c.cz(q[1],q[1]);c.x(q[1]);c.cz(q[1],q[1]);c.x(q[1]);},(a,0)|(0,a)=>c.cz(q[a],q[a]),(a,b)=>c.cz(q[a],q[b]),}}}
