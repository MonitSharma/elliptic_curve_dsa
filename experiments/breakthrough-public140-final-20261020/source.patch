+    fn scored(ops:&[Op])->usize{ops.iter().filter(|o|matches!(o.kind,OperationType::CCX|OperationType::CCZ)).count()}
+    fn draws(ops:&[Op])->usize{ops.iter().filter(|o|matches!(o.kind,OperationType::Hmr|OperationType::R)).count()}
