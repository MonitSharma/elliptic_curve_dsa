+                let mut expected:Option<(usize,Vec<usize>)>=None;
+                for mask in 1usize..1<<(m-1){let ds:Vec<_>=(1..m).filter(|&i|mask>>(i-1)&1!=0).collect();if ds.len()!=need||ds.iter().any(|&i|!allowed[i])||ds.windows(2).any(|p|p[1]==p[0]+1){continue;}
