-        assert_eq!(r.len(), 5, "N2: a parked rail holds 5 wires (bits 1..5)");
-        if !n2_lend(ri) {
-            continue;
-        }
-        let sg = r[4];
-        for i in 0..4 {
-            if !(fault && ri == 0 && i == 0) {
-                c.cx(sg, r[i]);
-            }
-            c.release_clean(r[i]);
-        }
-        N2_LENT.with(|l| l.borrow_mut()[ri] = r[0..4].to_vec());
