+
+impl B {
+    pub fn new() -> Self {
+        let mut b = B { ops: Vec::new(), stream: Stream::new(), next_q: 0, free_q: BTreeSet::new(), live: 0, peak: 0, bit: NO_BIT,
+                        rec: Vec::new(), tof: 0, next_bit: 10_000, rows: Vec::new(), peak_op: 0, allow_booth: true,
+                        cancel_simple_pairs: true, cancel_commuting_pairs: true, cancel_window: 4096,
+                        global_cancel: false, pending: Vec::new(),
+                        defer_mode:0, defer_tape:Vec::new(),erase_boxes:Vec::new(),box_tape:Vec::new() };
