+pub(crate) fn preposition_q19(b: &mut B, cycle: &[QubitId], sy: &[QubitId], q19: QubitId,
+                             act: QubitId, range: (usize, usize), dirty: &[QubitId]) -> Vec<Gate> {
+    preposition_qk(b, cycle, sy, q19, 19, act, range, dirty)
+}
