-    for x in [o.kind as u64, o.q_control2.0, o.q_control1.0, o.q_target.0, o.c_target.0, o.c_condition.0, o.r_target.0] {
-        h = (h ^ x).wrapping_mul(0x100000001B3);
-        h ^= h >> 29;
-    }
-    h
-}
-pub(super) fn mixes(ops: &[Op]) -> Vec<u64> {
