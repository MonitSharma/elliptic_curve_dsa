+    assert!(!row.bank.iter().any(|q|*q==row.c0||row.t.contains(q)||row.tail.contains(q)||row.s.contains(q)||row.dirty.contains(q)));
+    assert!(!row.s.iter().any(|q|*q==row.c0||row.t.contains(q)||row.tail.contains(q)));
