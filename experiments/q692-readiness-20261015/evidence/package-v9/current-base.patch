-        c.cx(b[i], t[i]);
-        c.cx(t[1], t[i]);
-    }
-    c.cx(b[top.min(b.len() - 1)], t[top]); // a shorter b (LF_SIGNWIRE): its sign wire
-    c.cx(t[1], t[top]);
