+// Inclusive full-eight-bit SY interval, represented by disjoint positive cubes.
+pub(crate) fn sy_interval_toggle(b:&mut B,sy:&[QubitId],lo:usize,hi:usize,base:&[(QubitId,bool)],target:QubitId,dirty:&[QubitId]){
+    if lo>hi{return;}assert_eq!(sy.len(),8);let mut start=lo;
+    while start<=hi{let mut block=1usize;while block<256&&start%(block*2)==0&&start+block*2-1<=hi{block*=2;}
+        let mask=255usize^(block-1);let mut ctl=base.to_vec();ctl.extend((0..8).filter(|i|mask>>i&1!=0).map(|i|(sy[i],start>>i&1==0)));mc_xor(b,&ctl,target,&[],dirty);start+=block;
+    }
+}
+pub(crate) fn high_q25_toggle(b:&mut B,sy:&[QubitId],kb:usize,base:&[(QubitId,bool)],target:QubitId,dirty:&[QubitId]){
+    assert!((22..=24).contains(&kb));sy_interval_toggle(b,sy,1,137-kb,base,target,dirty);
+}
+pub(crate) fn q25_cadd(b:&mut B,ring:&[QubitId],q:&[QubitId],sy:&[QubitId],kb:usize,span:usize,ctl:QubitId,sub:bool,zeros:&[QubitId],c0:QubitId,h:QubitId,dirty:&[QubitId],lsb:usize,loan_end:usize,flag:QubitId){
+    ring_cadd2_loan(b,ring,&q[..116],kb,span,ctl,sub,zeros,c0,h,dirty,lsb.min(116),loan_end.min(116),h);
+    for index in 116usize..128{let length=1;
+        if span<=index{continue;}sy_interval_toggle(b,sy,index+1,255,&[(ctl,false)],flag,dirty);
+        super::frogdrop_col::ring_cadd2(b,ring,&q[index..index+length],kb+index,span-index,flag,sub,zeros,c0,h,dirty);
+        sy_interval_toggle(b,sy,index+1,255,&[(ctl,false)],flag,dirty);
+    }
+}
+// Reflection i <-> SY+140-i groups overlapping high quotient owners into
+// disjoint transpositions; arbitrary target passengers are restored by replay.
+pub(crate) fn preposition_high_q25(b:&mut B,cycle:&[QubitId],sy:&[QubitId],act:QubitId,dirty:&[QubitId])->Vec<G>{
+    assert_eq!(cycle.len(),138);assert!(sy.len()==7||sy.len()==8);
+    rec(b,|b|{for value in 1usize..=115{
+        let mut pairs=std::collections::BTreeSet::new();
+        for kb in 22usize..=24{if value>137-kb{continue;}let owner=140-kb;let target=value+kb;if owner!=target{pairs.insert((owner.min(target),owner.max(target)));}}
+        let mut controls=vec![(act,false)];controls.extend(sy.iter().enumerate().map(|(i,&wire)|(wire,value>>i&1==0)));
+        for (a,z) in pairs{super::mid2::mc_swap(b,&controls,cycle[a],cycle[z],&[],dirty);}
+    }})
+}
+
+
+// On active admitted medium-size shots, SY96..103 and highestpark<=127;
+// reserve is clean and all Q-bank passengers belong to parked quotient.
+// Low7 SY is immutable while SY7 is transferred. Inactive high aliases
+// cannot borrow because act=0. SX0 must enter zero and returns before R use.
+pub(crate) fn transfer_bank32(b:&mut B,qbank:&[QubitId],reserve:&[QubitId],sy:&[QubitId],act:QubitId,flag:QubitId,dirty:&[QubitId])->Vec<G>{
+    assert_eq!(qbank.len(),8);assert_eq!(reserve.len(),8);assert_eq!(sy.len(),8);
+    assert!(!qbank.iter().any(|id|reserve.contains(id)||sy[..7].contains(id)||*id==act||*id==flag||dirty.contains(id)));
+    assert!(!reserve.iter().any(|id|sy[..7].contains(id)||*id==act||*id==flag||dirty.contains(id)));
+    let controls=[(act,false),(sy[3],true),(sy[4],true),(sy[5],false),(sy[6],false)];
+    rec(b,|b|{mc_xor(b,&controls,flag,&[],dirty);for i in 0..8{b.cswap(flag,qbank[i],reserve[i]);}mc_xor(b,&controls,flag,&[],dirty);})
+}
+
+
+pub(crate) fn care_borrowed_sz_flag(b:&mut B,v:&[QubitId],sz:&[QubitId],sy:&[QubitId],
+                  dest:&std::collections::BTreeSet<usize>,inverse:bool,dirty:&[QubitId],flag:QubitId)->Vec<G>{
+    assert!(!v.contains(&flag)&&!sz.contains(&flag)&&!sy.contains(&flag)&&!dirty.contains(&flag));
+    assert!(sz.len()>=8);let mut support=dest.clone();let small=size_partition(sy,true);let large=size_partition(sy,false);
+    let record=super::frogdrop_col::rec(b,|b|{
+        for (k,&bit) in sz.iter().enumerate(){let r=(1usize<<k)%v.len();let mut controls=vec![];
+            if k==6||k==7{
+                for cube in &small{let mut c=cube.clone();c.push((bit,false));controls.push(c);}
+                for cube in &large{
+                    if k==6{for &(mask,value)in &[(63usize,37usize),(62,38),(56,40),(48,48)]{let mut c=cube.clone();c.extend((0..6).filter(|&i|mask>>i&1!=0).map(|i|(sz[i],value>>i&1==0)));controls.push(c);}}
+                    else{let mut c=cube.clone();c.push((sz[5],true));controls.push(c);let mut c=cube.clone();c.extend((1..6).map(|i|(sz[i],i!=5)));controls.push(c);}
+                }
+            }else{controls.push(vec![(bit,false)]);}
+            if controls.len()>1 {
+                // The cubes are disjoint. Compute their union once in SX0,
+                // rotate under that one control, then restore SX0. SZ/SY
+                // and the dirty passengers are unchanged by the rotation.
+                let select=rec(b,|b|for literals in &controls{mc_xor(b,literals,flag,&[],dirty);});
+                b.play(&select,false);
+                virtual_crot_care(b,v,r,&support,&[vec![(flag,false)]],dirty);
+                b.play(&select,true);
+            } else {virtual_crot_care(b,v,r,&support,&controls,dirty);}
+            let shifted:Vec<_>=support.iter().map(|&i|(i+r)%v.len()).collect();support.extend(shifted);
+        }
+    });
+    if inverse{record.iter().rev().copied().collect()}else{record}
+}
+
+
+// On selected large-SY shots, ACT=1 and SZ+SY<=258. Thus SZ<=162,
+// so TC27 never clips. Retain selection in SX0, temporarily clear ACT
+// and SZ0, and borrow these as reciprocal flag and 25th remainder lane.
+// On unselected shots window writes are disabled and the reciprocal's
+// exact forward/inverse pair restores arbitrary borrowed state.
+pub(crate) fn stage1_v_compact_large25(b:&mut B,zh:&[QubitId],win:&[QubitId],
+    sz:&[QubitId],sy:&[QubitId],r24:&[QubitId],act:QubitId,root:QubitId,
+    dirty:&[QubitId],bank:bool)->Vec<G>{
+    assert_eq!(zh.len(),25);assert_eq!(r24.len(),24);
+    assert!(sz.len()==8 || sz.len()==9);assert!(sy.len()>=7);
+    assert!(!r24.contains(&sz[0])&&!r24.contains(&act)&&!r24.contains(&root));
+    assert!(!zh.contains(&sz[0])&&!zh.contains(&act)&&!zh.contains(&root));
+    let cubes = if bank {vec![(127usize,0usize),(120,104),(112,112)]}
+                else {vec![(127usize,0usize),(96,96)]};
+    rec(b,|b|{for (mask,value) in cubes.iter().copied(){for bit in 0..=1{
+        let mut literals=vec![(act,false),(sz[0],bit==0)];
+        literals.extend((0..7).filter(|i|mask>>i&1!=0).map(|i|(sy[i],value>>i&1==0)));
+        mc_xor(b,&literals,root,&[],dirty);
+        if bit==1 {b.cx(root,sz[0]);}
+        b.x(act);
+        let mut r=r24.to_vec();r.push(sz[0]);
+        let scratch=S1{r,f:act,zero:r24[17],sgn:act,gt:vec![act],
+            anc:vec![],andc:vec![],chain:vec![],dirty:dirty.to_vec()};
+        let forward=stage1_v_compact(b,zh,win,sz,(101,230),&scratch,root,true);
+        let restore=stage1_v_compact(b,zh,win,sz,(101,230),&scratch,root,false);
+        b.play(&forward,false);b.play(&restore,true);
+        b.x(act);
+        if bit==1 {b.cx(root,sz[0]);}
+        mc_xor(b,&literals,root,&[],dirty);
+    }}})
+}
