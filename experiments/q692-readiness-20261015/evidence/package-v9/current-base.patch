-    let si = 1 - (ahead - 1) % 2;
-    let mut ws = vec![wk.r[si][1 - o], wk.r[si][2 - o]];
-    for t in 0..ahead {
-        if t > 0 {
-            ws.push(wk.tape[t][0]);
-        }
-        ws.push(wk.tape[t][1]);
-    }
-    ws
