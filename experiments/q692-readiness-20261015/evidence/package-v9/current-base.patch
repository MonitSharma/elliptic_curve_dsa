+        let (t_opre, t_tmp, t_tmp2) = if SLIM { (fd.sx[..fd.sx.len() - 1].to_vec(), s[0], s[2]) }
+                                      else { (sc.opre.clone(), sc.tmp, sc.tmp2) };
