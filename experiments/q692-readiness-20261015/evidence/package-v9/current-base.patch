+                    let (t0, o0) = (pts[shot].0, pts[shot].2);
+                    let dx = t0.add_mod(modp() - o0, modp());
+                    let xp = o0.add_mod(modp() - e.0, modp());
+                    eprintln!("PAFAIL dx={dx:#x} xp={xp:#x} wrong={} phase={}", gx != e.0 || gy != e.1, ph);
