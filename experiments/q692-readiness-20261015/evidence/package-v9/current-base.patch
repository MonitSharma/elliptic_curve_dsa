+        b
+    }
+
+    pub fn finish_stream(&mut self) -> Option<u64> {
+        self.flush_global();
+        self.stream.take().map(Stream::finish)
+    }
+
+    // ---------------------------------------------------------------- qubits
+    pub fn alloc(&mut self) -> QubitId {
+        let id = if let Some(&q) = self.free_q.iter().next() {
+            self.free_q.remove(&q);
+            q
+        } else {
+            self.next_q += 1;
+            self.next_q - 1
+        };
+        self.live += 1;
+        if self.live > self.peak {
+            self.peak = self.live;
+            self.peak_op = self.ops.len();
+        }
+        QubitId(id)
+    }
+    pub fn alloc_n(&mut self, n: usize) -> Vec<QubitId> {
+        (0..n).map(|_| self.alloc()).collect()
+    }
+    /// Release a qubit that is |0> on every shot.
+    pub fn free(&mut self, q: QubitId) {
+        assert!(self.rec.is_empty(), "free inside a recording");
+        assert!(self.free_q.insert(q.0), "double free q{}", q.0);
+        self.live -= 1;
+    }
+    pub fn free_n(&mut self, qs: &[QubitId]) {
+        for &q in qs {
+            self.free(q);
+        }
+    }
+    pub fn width(&self) -> u64 {
+        self.next_q
+    }
+    pub fn op_count(&self) -> u64 {
+        self.stream.as_ref().map_or(0, |s| s.count) + self.ops.len() as u64 + self.pending.len() as u64
+    }
+    pub fn pending_count(&self) -> usize { self.pending.len() }
+
+    // ---------------------------------------------------------------- registers
+    pub fn declare_qubits(&mut self, reg: u64, qs: &[QubitId]) {
+        self.raw(Op { kind: OperationType::Register, r_target: RegisterId(reg), ..Op::empty() });
+        for &q in qs {
+            self.raw(Op { kind: OperationType::AppendToRegister, q_target: q, r_target: RegisterId(reg),
+                          ..Op::empty() });
+        }
+    }
+    pub fn declare_bits(&mut self, reg: u64, n: usize) -> Vec<BitId> {
+        self.raw(Op { kind: OperationType::Register, r_target: RegisterId(reg), ..Op::empty() });
+        let bs: Vec<BitId> = (0..n).map(|i| BitId(1 + reg * 1000 + i as u64)).collect();
+        for &b in &bs {
+            self.raw(Op { kind: OperationType::AppendToRegister, c_target: b, r_target: RegisterId(reg),
+                          ..Op::empty() });
+        }
+        bs
+    }
+
+    // ---------------------------------------------------------------- emission
+    fn raw_direct(&mut self, op: Op) {
+        debug_assert!({ op.validate(); true });
+        let _ = NO_REG;
+        if let Some(stream) = &mut self.stream { stream.push(&op); } else { self.ops.push(op); }
+    }
+    pub fn flush_global(&mut self) {
+        for op in std::mem::take(&mut self.pending) { self.raw_direct(op); }
+    }
+    fn raw(&mut self, op: Op) {
+        let controlled_x = op.c_condition == NO_BIT && matches!(op.kind,
+            OperationType::X | OperationType::CX | OperationType::CCX);
+        // Never cancel the configured Fiat-Shamir nonce pair (NONCE, NONCE_CTRL in mod.rs).
+        let nonce = op.q_target == QubitId(super::NONCE as u64) && match super::NONCE_CTRL {
+            Some(c) => op.kind == OperationType::CX && op.q_control1 == QubitId(c as u64),
+            None => op.kind == OperationType::X,
+        };
+        if !self.global_cancel || !controlled_x || nonce {
+            self.flush_global();
+            self.raw_direct(op);
+            return;
+        }
+        let controls = |g: &Op| match g.kind {
+            OperationType::X => (None, None),
+            OperationType::CX => (Some(g.q_control1), None),
+            OperationType::CCX => (Some(g.q_control1), Some(g.q_control2)),
+            _ => unreachable!(),
+        };
+        let (a, c) = controls(&op);
+        let mut found = None;
+        for i in (self.pending.len().saturating_sub(self.cancel_window)..self.pending.len()).rev() {
+            let prior = &self.pending[i];
+            if *prior == op { found = Some(i); break; }
+            let (d, e) = controls(prior);
+            if a == Some(prior.q_target) || c == Some(prior.q_target)
+                || d == Some(op.q_target) || e == Some(op.q_target) { break; }
+        }
+        if let Some(i) = found {
+            self.pending.remove(i);
+            if op.kind == OperationType::CCX { self.tof -= 2; }
+        } else { self.pending.push(op); }
+    }
+    fn emit(&mut self, g: G, inverse: bool) {
+        let e = |kind, t: QubitId, c1: QubitId, c2: QubitId| Op { kind, q_target: t, q_control1: c1, q_control2: c2,
+                                                             ..Op::empty() };
+        match g {
+            G::DeferredErase(id,inv) => {self.emit_erasure(id,inv^inverse);},
+            G::RowAdd(id, inv) => { let row=self.rows[id as usize].clone(); super::row_add::emit(self,&row,inv ^ inverse); },
+            G::X(t) => self.raw(e(OperationType::X, t, NO_QUBIT, NO_QUBIT)),
+            G::Cx(c, t) => self.raw(e(OperationType::CX, t, c, NO_QUBIT)),
+            G::Cz(a, b) => self.raw(e(OperationType::CZ, b, a, NO_QUBIT)),
+            G::Swap(a, b) => self.raw(e(OperationType::Swap, b, a, NO_QUBIT)),
+            G::Ccx(a, b, t) => {
+                self.tof += 1;
+                self.raw(e(OperationType::CCX, t, a, b))
+            }
+            G::XIf(t, c) => self.raw(Op { kind: OperationType::X, q_target: t, c_condition: c, ..Op::empty() }),
+            G::ZIf(t, c) => self.raw(Op { kind: OperationType::Z, q_target: t, c_condition: c, ..Op::empty() }),
+            G::AndC(a, b, t) | G::AndU(a, b, t) => {
+                let compute = matches!(g, G::AndC(..)) != inverse;
+                if compute {
+                    self.flush_global();
+                    self.tof += 1;
+                    self.raw_direct(e(OperationType::CCX, t, a, b));
+                } else {
+                    let m = self.bit;
+                    self.raw(Op { kind: OperationType::Hmr, q_target: t, c_target: m, ..Op::empty() });
+                    self.raw(Op { kind: OperationType::CZ, q_target: b, q_control1: a, c_condition: m,
+                                  ..Op::empty() });
+                }
+            }
+        }
+    }
+    /// Emit one gate (or record it if a recording is open).
+    pub fn g(&mut self, g: G) {
+        if let Some(r) = self.rec.last_mut() {
+            // Equal controlled-X gates cancel across intervening commuting
+            // controlled-X gates. Neither target may be a control of the
+            // other gate; equal targets are safe. Stop at every other kind.
+            if self.cancel_commuting_pairs {
+                let info = |gate: G| match gate {
+                    G::X(t) => Some((t, None, None)),
+                    G::Cx(a, t) => Some((t, Some(a), None)),
+                    G::Ccx(a, c, t) => Some((t, Some(a), Some(c))),
+                    _ => None,
+                };
+                if g != G::Cx(QubitId(5), QubitId(274)) {
+                    if let Some((t, a, c)) = info(g) {
+                        let mut found = None;
+                        for i in (r.len().saturating_sub(self.cancel_window)..r.len()).rev() {
+                            let prior = r[i];
+                            if prior == g { found = Some(i); break; }
+                            let commute = info(prior).is_some_and(|(u, d, e)|
+                                a != Some(u) && c != Some(u) && d != Some(t) && e != Some(t));
+                            if !commute { break; }
+                        }
+                        if let Some(i) = found { r.remove(i); return; }
+                    }
+                }
+            }
+            // Adjacent self-inverse gates cancel as exact operators on every
+            // input, including arbitrary dirty passengers. Keep the explicit
+            // Fiat-Shamir nonce pair in the final physical stream.
+            if self.cancel_simple_pairs && matches!(g, G::X(..) | G::Cx(..) | G::Ccx(..) | G::Cz(..) | G::Swap(..))
+                && !is_nonce_gate(&g) && r.last() == Some(&g) {
+                r.pop();
+                return;
+            }
+            r.push(g);
+        } else {
+            self.emit(g, false);
+        }
+    }
+    pub fn begin(&mut self) {
+        self.rec.push(Vec::new());
+    }
+    pub fn recording_len(&self) -> usize { self.rec.last().map_or(0, Vec::len) }
+    pub fn end(&mut self) -> Vec<G> {
+        self.rec.pop().expect("no recording")
+    }
+    /// Emit a recording forward or as its inverse (into the enclosing recording if one is open).
+    pub fn play(&mut self, r: &[G], inverse: bool) {
+        if inverse {
+            for &g in r.iter().rev() {
+                let gi = match g {
+                    G::AndC(a, b, t) => G::AndU(a, b, t),
+                    G::AndU(a, b, t) => G::AndC(a, b, t),
+                    G::RowAdd(id, inv) => G::RowAdd(id, !inv),
+                    G::DeferredErase(id,inv)=>G::DeferredErase(id,!inv),
+                    other => other,
+                };
+                self.g(gi);
+            }
+        } else {
+            for &g in r {
+                self.g(g);
+            }
+        }
+    }
