+            }
+            shots += 64;
+        }
+        eprintln!("TIEUNIT t={t} rev={rev} tie={tie} rand={rand} active={active} proxy={proxy} fold={fold} shots={shots} wrong={bad} phase_bad={phb}");
+    }
