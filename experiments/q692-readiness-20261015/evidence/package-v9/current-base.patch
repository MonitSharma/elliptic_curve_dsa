-fn lit_maj(c: &mut Builder, recs: &mut Vec<AndRec>, x: Lit, y: Lit, cin: Lit) -> Lit {
-    use Lit::*;
-    let and2 = |c: &mut Builder, recs: &mut Vec<AndRec>, p: Lit, q: Lit| -> Lit {
-        match (p, q) {
-            (Zero, _) | (_, Zero) => Zero,
-            (One, o) | (o, One) => o,
-            (W(a, ia), W(b, ib)) => W(lit_and(c, recs, (a, ia), (b, ib), None), false),
