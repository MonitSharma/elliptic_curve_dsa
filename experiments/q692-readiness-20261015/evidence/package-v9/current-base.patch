+#[derive(Clone)]
+struct DeferredRow { row:super::row_add::Row,inverse:bool,masks:Vec<BitId> }
+#[derive(Clone)]
+struct ErasureBox { tag:u32, rec:Vec<G>, outputs:Vec<QubitId> }
+#[derive(Clone)]
+struct DeferredBox { tag:u32, outputs:Vec<QubitId>, key:[u8;32], masks:Vec<BitId> }
