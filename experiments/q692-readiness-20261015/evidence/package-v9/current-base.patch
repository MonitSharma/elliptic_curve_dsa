+/// Place q19 into the Q-cycle position that rotates to lane 19. This clears
+/// its SX owner during the HT payload park whenever the position is in range.
+pub(crate) fn preposition_qk(b: &mut B, cycle: &[QubitId], sy: &[QubitId], qk: QubitId,
+                             bit: usize, act: QubitId, range: (usize, usize), dirty: &[QubitId]) -> Vec<Gate> {
+    assert!(cycle.len() > bit && cycle.last() == Some(&qk));
+    rec(b, |b| {
+        let lane = |v: usize| {
+            let idx = v + bit;
+            if idx < cycle.len() && cycle[idx] != qk { Some(cycle[idx]) } else { None }
+        };
+        super::mid2::dec_swap(b, sy, range.0, range.1, &lane, qk, &[(act, false)], &[], &[], dirty);
+    })
+}
