+ for _ in 0..2{
+  for &q in z{b.cx(g,q);}
+  super::arith::ttk_add(b,a,&z[..n],Some(g),Some((z[n],d)));
+  let mut dirty=a.to_vec();dirty.extend([d,e]);
+  b.begin();super::modp_frogdrop::add_const_exact(b,z,Some(g),c,&dirty);let shift=b.end();b.play(&shift,true);
+  short_less_plain(b,z,a,g,d);high_interval_plain(b,z,c,g,a);
+ }
+ for _ in 0..2{
+  for &q in &z[..n]{b.cx(g,q);}
+  super::arith::ttk_add(b,a,&z[..n],Some(g),None);
+  short_less_plain(b,z,a,g,d);
+ }
+}
+/// Exact canonical inverse of doubling, with explicit inverse wire relabeling.
+fn halve_target(b:&mut B,z:&mut Vec<QubitId>,dirty:&[QubitId],c:u64){
+ let mut prev=z.clone();prev.rotate_left(1);let mut after=prev.clone();
+ b.begin();super::canonical_short::mod_double_canonical(b,&mut after,dirty,c);let rec=b.end();
+ assert_eq!(&after,z);b.play(&rec,true);*z=prev;
+}
+/// z+=k*a (or ctl*k*a) modp for a positive public k. The initial m inverse
+/// doublings and final m doublings cancel the scale on z, including ctl=0.
+/// Their wire rotations cancel too. Every dirty/source loan is exactly returned.
+pub fn add_multiple(b:&mut B,z:&[QubitId],a:&[QubitId],y:&[QubitId],k:usize,c:u64,ctl:Option<QubitId>){
+ assert!(k>=1);let m=(usize::BITS-1-k.leading_zeros())as usize;
+ let mut zz=z.to_vec();let mut dirty=y.to_vec();dirty.push(a[0]);
+ for _ in 0..m{halve_target(b,&mut zz,&dirty,c);}
+ for i in(0..=m).rev(){
+  if (k>>i)&1!=0{if let Some(g)=ctl{add_a(b,&zz,a,y,g,c);}else{add_a_uncontrolled(b,&zz,a,y,c);}}
+  if i>0{super::canonical_short::mod_double_canonical(b,&mut zz,&dirty,c);}
+ }
+ assert_eq!(zz,z);
+}
+/// Controlled canonical involution R(z)=A_k+k*a-z modp.
+pub fn reflection(b:&mut B,z:&[QubitId],a:&[QubitId],y:&[QubitId],k:usize,c:u64){
+ let ctl=y[0];let d=dirty(a,y);for &q in z{b.cx(ctl,q);}add_const(b,z,ctl,N::from(c),&d,true);
+ add_multiple(b,z,a,y,k,c,Some(ctl));
+ let anchor=N::from(k as u64)<<(z.len()-4);add_const_mod(b,z,a,y,ctl,anchor+N::from(1u64),c);
+}
+/// g ^= [z=A_k] XOR[z=k*a modp], preserving z/source/all other borrowed lanes.
+pub fn pair_predicate(b:&mut B,z:&[QubitId],a:&[QubitId],y:&[QubitId],k:usize,c:u64){
+ let anchor=N::from(k as u64)<<(z.len()-4);eq_const(b,z,anchor,y[0],a);
+ b.begin();add_multiple(b,z,a,y,k,c,None);let shift=b.end();b.play(&shift,true);eq_const(b,z,N::ZERO,y[0],a);b.play(&shift,false);
+}
+/// Exact canonical transposition A_k <-> k*a modp, for every positive a<=p/2.
+/// If both points coincide, identity. Other canonical inputs unchanged.
+pub fn pair_swap(b:&mut B,z:&[QubitId],a:&[QubitId],y:&[QubitId],k:usize,c:u64){
+ assert_eq!(z.len(),a.len()+1);assert!(y.len()>=8&&k>=1&&k<=15);assert!(N::from(c)+N::from(1u64)<(N::from(1u64)<<(z.len()-4)));
+ for _ in 0..2{reflection(b,z,a,y,k,c);pair_predicate(b,z,a,y,k,c);}
+}
+pub fn generic_seed(b:&mut B,z:&[QubitId],a:&[QubitId],y:&[QubitId],c:u64){for k in 1..=15{pair_swap(b,z,a,y,k,c);}}
+
+/// Exact field product with a positive inverse magnitude 1..p/2. Entry z low252
+/// is zero, z high4 holds the old multiplier high4, and ylow preserves its low252.
+/// All borrowed lanes are restored; output wire order follows doubling relabels.
+pub fn product_consume_four_high_nf(b:&mut B,z:&mut Vec<QubitId>,a:&[QubitId],ylow:&[QubitId]){
+ assert_eq!(z.len(),256);assert_eq!(a.len(),255);assert_eq!(ylow.len(),252);
+ let c=super::modp_frogdrop::C;generic_seed(b,z,a,ylow,c);
+ super::seed_exception_corrections_fourth::correct_seed_exceptions(b,z,a,ylow);
+ for i in(0..252).rev(){horner_round(b,z,a,ylow,i);}
+}
+pub fn horner_round(b:&mut B,z:&mut Vec<QubitId>,a:&[QubitId],ylow:&[QubitId],i:usize){
+ let c=super::modp_frogdrop::C;
+ // Doubling does not read the inverse source. Its exact digit4 increment
+ // needs253 dirty loans, so borrow and restore source a[0] alongside ylow252.
+ let mut double_dirty=ylow.to_vec();double_dirty.push(a[0]);
+ super::canonical_short::mod_double_canonical(b,z,&double_dirty,c);
+ short_modadd_canonical(b,z,a,ylow[i],ylow[(i+1)%252],ylow[(i+2)%252],ylow[(i+3)%252],ylow[(i+4)%252],c);
+}
