-const M_FIXED_REV: usize = 4 + 14;
-/// [`merged_rev2`]: carries into bits 1..4, 3 borrows, k-gate + 3 gated mu bits, u, monomials.
-const M_FIXED_REV2: usize = 4 + 3 + 4 + 14;
