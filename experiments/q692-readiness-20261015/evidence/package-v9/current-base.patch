-pub fn run(ops: Vec<Op>) -> Vec<Op> {
-    let rows = rows();
-    let ops = if TEST_SHIFT { test_shift(ops, &rows) } else { ops };
-    let rows = anchor_rows(&ops, rows);
-    run_rows(ops, rows)
-}
