-    let fixed = (1 + if rev { if lf_merged_rev2() { M_FIXED_REV2 } else { 5 + M_FIXED_REV } } else { M_FIXED_FWD } - core_freed(true)).saturating_sub(g4_fake() + lowcar_max());
