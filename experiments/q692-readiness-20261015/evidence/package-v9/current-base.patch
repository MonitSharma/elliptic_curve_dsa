+pub struct B {
+    pub ops: Vec<Op>,
+    stream: Option<Stream>,
+    next_q: u64,
+    free_q: BTreeSet<u64>,
+    pub live: u64,
+    pub peak: u64,
+    bit: BitId,
+    rec: Vec<Vec<G>>,
+    pub tof: u64,
+    pub peak_op: usize,
+    pub allow_booth: bool,
+    pub cancel_simple_pairs: bool,
+    pub cancel_commuting_pairs: bool,
+    pub cancel_window: usize,
+    pub global_cancel: bool,
