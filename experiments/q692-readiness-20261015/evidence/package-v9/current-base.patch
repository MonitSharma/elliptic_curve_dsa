+        let pr = rec(b, |b| probe_gated(b, &ring, lo, cp.l0, &sc.sz, &[(sc.g, false)], &pre, sc.cmpc, &[sc.f, sc.bq],
+                                        &dirty));
+        b.play(&pr, true);
+        let pr = rec(b, |b| probe_gated(b, &ring, lo, cp.xw.min(n / 2), &sc.sz, &[(sc.g, false)], &pre, sc.cmpc,
+                                        &[sc.f, sc.bq], &dirty));
+        b.play(&pr, false);
+        dlf(b);
+    }
+    b.play(&probe_z, true);
+    if std::env::var_os("D3_TRACE_PHASE").is_some() { mark(b, 802); }
