+//! Finite K24 stage1_v test on the N276, 693-wire candidate frame.
+use super::builder::{B, G};
+use super::frogdrop_col::{rec, ColPar};
+use super::frogdrop_sched::N;
+use super::midg::{stage1_v, S1, TC};
+use super::tests_frogdrop::{run, Rng};
+use crate::circuit::{Op, OperationType as K, QubitId, NO_BIT};
+
+fn put(q: &mut [u64], reg: &[QubitId], lane: usize, v: N) {
+    for (i, p) in reg.iter().enumerate() {
+        q[p.0 as usize] = (q[p.0 as usize] & !(1u64 << lane))
+            | (u64::from(v.bit(i)) << lane);
+    }
+}
+
+#[test]
+fn compact_virtual_high_one_exhaustive() {
+    let mut total = 0usize;
+    for n in 1..=7 {
+        let make = |compact: bool| {
+            let mut b = builder();
+            let t = b.alloc_n(n);
+            let s = b.alloc_n(n);
+            let cin = b.alloc();
+            let out = b.alloc();
+            let gate = rec(&mut b, |b| {
+                if compact { super::frogdrop::cmp_csub_carries_vh1(b, &t, &s[..n - 1], cin, out); }
+                else { super::frogdrop::cmp_csub_carries(b, &t, &s, cin, out, &[]); }
+            });
+            let f = emitted(&mut b, &gate, false);
+            let r = emitted(&mut b, &gate, true);
+            (t, s, cin, out, b.width() as usize, f, r)
+        };
+        let (t, s, cin, out, width, f, r) = make(true);
+        let (_, _, _, _, _, reference, _) = make(false);
+        let cases: Vec<_> = (0..1usize << n).flat_map(|tv|
+            (1usize << (n - 1)..1usize << n).flat_map(move |sv|
+                (0..4).map(move |flags| (tv, sv, flags)))).collect();
+        for chunk in cases.chunks(64) {
+            let mut input = vec![0u64; width];
+            for (lane, &(tv, sv, flags)) in chunk.iter().enumerate() {
+                put(&mut input, &t, lane, N::from(tv as u64));
+                put(&mut input, &s, lane, N::from(sv as u64));
+                input[cin.0 as usize] |= ((flags & 1) as u64) << lane;
+                input[out.0 as usize] |= ((flags >> 1) as u64) << lane;
+            }
+            let got = run(&f, width, &|q| *q = input.clone());
+            let want = run(&reference, width, &|q| *q = input.clone());
+            let mask = if chunk.len() == 64 { !0 } else { (1u64 << chunk.len()) - 1 };
+            for (a, b) in got.q.iter().zip(&want.q) { assert_eq!((a ^ b) & mask, 0, "n={n}"); }
+            assert_eq!(got.phase & mask, 0);
+            let back = run(&r, width, &|q| *q = got.q.clone());
+            assert_eq!(back.q, input);
+            assert_eq!(back.phase, 0);
+            total += chunk.len();
+        }
+    }
+    eprintln!("COMPACT_HIGH_ONE_EXHAUSTIVE cases={total}");
+}
+
+#[test]
+fn compact_restoring_step_exhaustive() {
+    let mut total = 0usize;
+    for k in 2..=8 {
+        let mut b = builder();
+        let r = b.alloc_n(k);
+        let d = b.alloc_n(k);
+        let f = b.alloc();
+        let mut after = r.clone();
+        let high = after.pop().unwrap(); after.insert(0, high);
+        let gate = rec(&mut b, |b| {
+            b.cx(r[k - 1], f); b.cx(f, after[0]);
+            super::frogdrop::cmp_csub_carries_vh1(b, &after[1..], &d[1..k - 1], after[0], f);
+            b.x(after[0]); b.cx(f, after[0]); b.cx(after[0], f); b.x(f);
+        });
+        let forward = emitted(&mut b, &gate, false);
+        let reverse = emitted(&mut b, &gate, true);
+        let cases: Vec<_> = (1usize << (k - 1)..1usize << k).filter(|d| d & 1 == 1)
+            .flat_map(|d| (0..d).map(move |r| (d, r))).collect();
+        for chunk in cases.chunks(64) {
+            let mut input = vec![0u64; b.width() as usize];
+            for (lane, &(dv, rv)) in chunk.iter().enumerate() {
+                put(&mut input, &r, lane, N::from(rv as u64));
+                put(&mut input, &d, lane, N::from(dv as u64));
+            }
+            let got = run(&forward, input.len(), &|q| *q = input.clone());
+            for (lane, &(dv, rv)) in chunk.iter().enumerate() {
+                assert_eq!(get(&got.q, &after, lane), N::from(((2*rv + 1) % dv) as u64),
+                           "k={k} d={dv} r={rv}");
+                assert_eq!((got.q[f.0 as usize] >> lane) & 1, 0);
+                assert_eq!(get(&got.q, &d, lane), N::from(dv as u64));
+            }
+            assert_eq!(got.phase, 0);
+            let back = run(&reverse, input.len(), &|q| *q = got.q.clone());
+            assert_eq!(back.q, input);
+            assert_eq!(back.phase, 0);
+            total += chunk.len();
+        }
+    }
+    eprintln!("COMPACT_STEP_EXHAUSTIVE cases={total}");
+}
