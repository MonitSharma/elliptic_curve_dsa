+        // probe's inverse erases
+        let dlf = |b: &mut B| {
+            let gt = sz_gt_sy(b, fd, sc);
+            mc_xor(b, &[(ph, true), (sc.sw, false), (sc.sz[SZB - 1], false)], sc.g, &[sc.f], &dirty);
+            b.play(&gt, true);
+        };
