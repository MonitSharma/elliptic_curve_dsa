+    pub fn deferred_inverse(&mut self) { assert!(self.rec.is_empty()); self.defer_mode=2; }
+    pub fn deferred_finish(&mut self) { assert!(self.rec.is_empty()&&self.defer_tape.is_empty()&&self.box_tape.is_empty()); self.defer_mode=0; }
