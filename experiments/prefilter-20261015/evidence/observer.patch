+    #[track_caller]
+    pub fn alloc_qubits(&mut self, n: usize) -> Vec<QubitId> {
+        if self.peak_census.enabled() {
+            let c = std::panic::Location::caller();
+            self.peak_census.batch(Some((c.file(), c.line())));
