+    pub fn new() -> Self {
+        Self {
+            ops: Vec::new(),
+            // Count-only model mode is disabled in this submission.
+            model: false,
+            model_depth: 0, model_total: 0, model_weighted: 0.0,
+            model_phase_native: 0, model_phase_weighted: 0.0, model_max: 0,
+            phase_kind_ops: [0; OP_KINDS],
+            next_qubit: 0,
+            next_bit: 0,
+            free_bits: Vec::new(),
+            next_register: 0,
+            free_qubits: Vec::new(),
+            active_qubits: 0,
+            peak_qubits: 0,
+            phase: "init",
