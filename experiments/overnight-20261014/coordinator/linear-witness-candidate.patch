+pub(crate) fn simplify(ops: Vec<Op>) -> Vec<Op> {
+    let mut state = Support::new(&ops);
+    let mut result = Vec::with_capacity(ops.len());
+    for op in ops {
+        state.step(&op).emit(op, &mut result);
+    }
+    result
