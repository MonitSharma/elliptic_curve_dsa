+    let old=RECIPE.with(|x|x.replace(on));let result=f();RECIPE.with(|x|x.set(old));result
+}
+#[cfg(test)] thread_local! {static BANK_SWITCH:std::cell::Cell<bool>=const{std::cell::Cell::new(true)};}
