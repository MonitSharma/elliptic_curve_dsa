+//! Generated from the source-bound full constructor and six exact phase identities.
+//! Keeps31constructionANDs, frees6wires for the ladder, then pays6ANDs to restore
+//! the original undo interface. No nonce, input-packet or census simplification.
+use super::*;
+#[cfg(test)]
+thread_local! { static MODE: std::cell::Cell<bool> = const { std::cell::Cell::new(false) }; }
+#[cfg(test)] pub(super) fn enabled() -> bool { MODE.with(|x|x.get()) }
+#[cfg(not(test))] pub(super) fn enabled() -> bool { true }
+#[cfg(test)] thread_local! { static HEAD_PLAN: std::cell::Cell<bool> = const { std::cell::Cell::new(false) }; }
+#[cfg(test)] pub(super) fn head_plan() -> bool { HEAD_PLAN.with(|x|x.get()) }
+#[cfg(not(test))] pub(super) fn head_plan() -> bool { true }
+#[cfg(test)] pub(super) fn with_head_plan<R>(on:bool,f:impl FnOnce()->R)->R {
+    let before=HEAD_PLAN.with(|x|x.replace(on));let result=f();HEAD_PLAN.with(|x|x.set(before));result
+}
+#[cfg(test)] pub(super) fn with_mode<R>(on:bool,f:impl FnOnce()->R)->R {
+    let before=MODE.with(|x|x.replace(on)); let result=f(); MODE.with(|x|x.set(before));result
+}
+const TRANSFORM: &[(u8,usize,usize)] = &[
+    (0,30,26),
+    (0,30,22),
+    (0,30,21),
+    (0,30,16),
+    (0,30,15),
+    (0,30,14),
+    (0,30,13),
+    (0,30,8),
