+use sha3::digest::XofReader;
+type Layout=(Vec<Op>,Vec<QubitId>,Vec<QubitId>,Vec<QubitId>,Vec<QubitId>,usize,u32,usize);
+fn mode<R>(on:bool,f:impl FnOnce()->R)->R {
