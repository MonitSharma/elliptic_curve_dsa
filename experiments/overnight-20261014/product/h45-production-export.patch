+impl Poly {
+    fn constant(v: u64) -> Self {
+        let mut terms = BTreeMap::new();
+        if v != 0 { terms.insert(Vec::new(), v); }
+        Self(terms)
+    }
+    fn variable(id: u32) -> Self { Self(BTreeMap::from([(vec![id], u64::MAX)])) }
+    fn scalar(&self) -> Option<u64> {
