+    let mut extra = [0u8; 1];
+    match dec.read(&mut extra) {
+        Ok(0) => {}
+        Ok(_) => return Err(format!("{path}: trailing data after {n} ops")),
+        Err(e) => return Err(format!("{path}: error checking for trailing data: {e}")),
+    }
