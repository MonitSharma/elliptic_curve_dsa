+#[test]
+fn canonicalization_removes_inessential_variables_at_u128_boundary() {
+    let t=Truth::canonical((0..7).collect(), u128::MAX);
+    assert!(t.is_one());
+    let mut table=0u128;
+    for row in 0..128 { table |= u128::from(row & 64 != 0) << row; }
+    let t=Truth::canonical((0..7).collect(),table);
+    assert_eq!(t.atoms,vec![6]); assert_eq!(t.table,2);
+    assert_eq!(t.complement().table,1);
+}
