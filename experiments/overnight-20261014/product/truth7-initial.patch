+use super::*;
+use crate::circuit::{BitId, QubitId, RegisterId};
+use crate::sim::Simulator;
+
+struct Fixed;
+impl sha3::digest::XofReader for Fixed {
+    fn read(&mut self, output: &mut [u8]) { output.fill(0xa5); }
+}
+
+fn gate(kind: OperationType, a: u64, b: u64, t: u64) -> Op {
+    let mut o = Op::empty();
+    o.kind = kind;
+    if a != u64::MAX { o.q_control1 = QubitId(a); }
+    if b != u64::MAX { o.q_control2 = QubitId(b); }
+    o.q_target = QubitId(t);
+    o
+}
+fn conjunction_fixture() -> Vec<Op> {
+    let mut ops = Vec::new();
+    for q in 0..7 {
+        let mut o = Op::empty(); o.kind = OperationType::AppendToRegister;
+        o.q_target = QubitId(q); o.r_target = RegisterId(0); ops.push(o);
+    }
+    let mut reg = Op::empty(); reg.kind = OperationType::Register;
+    reg.r_target = RegisterId(0); ops.push(reg);
+    // Same seven-way conjunction, left-associated versus balanced; the
+    // six-atom abstraction cannot relate the two final opaque atoms.
+    let pairs = [(0,1,7),(7,2,8),(8,3,9),(9,4,10),(10,5,11),(11,6,12),
+                 (0,1,13),(2,3,14),(4,5,15),(13,14,16),(15,6,17),(16,17,18)];
+    for (a,b,t) in pairs { ops.push(gate(OperationType::CCX,a,b,t)); }
+    ops.push(gate(OperationType::X,u64::MAX,u64::MAX,18));
+    ops.push(gate(OperationType::CCX,12,18,19));
+    ops
+}
+
+#[test]
+fn seven_atom_identity_exhaustive_and_fault_detection() {
+    let ops = conjunction_fixture();
+    let reduced = simplify(ops.clone());
+    assert_eq!(reduced.len(), ops.len()-1, "seven-way complement product must disappear");
+    let old = super::super::truth_simplify::simplify(ops.clone());
+    assert_eq!(old.len(), ops.len(), "fixture must exercise new support rather than old proof");
+    let mut fault = reduced.clone();
+    let site = fault.iter().position(|o| o.kind == OperationType::X).unwrap();
+    fault.remove(site);
+    let mut detected = 0;
+    for input in 0..128 {
+        let mut ra=Fixed; let mut rb=Fixed; let mut rf=Fixed;
+        let mut a=Simulator::new(20,2,&mut ra); let mut b=Simulator::new(20,2,&mut rb);
+        let mut f=Simulator::new(20,2,&mut rf);
+        for q in 0..7 { a.qubits[q]=(input>>q)&1; }
+        b.qubits.clone_from(&a.qubits); f.qubits.clone_from(&a.qubits);
+        a.apply_iter(ops.iter()); b.apply_iter(reduced.iter()); f.apply_iter(fault.iter());
+        assert_eq!(a.qubits,b.qubits); assert_eq!(a.bits,b.bits); assert_eq!(a.phase,b.phase);
+        detected += usize::from(a.qubits != f.qubits || a.phase != f.phase);
+        // Inverse over the full tested basis domain returns every scratch lane.
+        b.apply_iter(reduced.iter().rev());
+        assert!(b.qubits[7..].iter().all(|&v| v == 0));
+        for q in 0..7 { assert_eq!(b.qubits[q],(input>>q)&1); }
+    }
+    assert_eq!(detected,1, "missing complement must be caught at all-one input");
+}
+
+#[test]
+fn conditioned_measurement_preserves_basis_phase_and_snapshot() {
+    let mut ops=conjunction_fixture();
+    for bit in 0..2 {
+        let mut o=Op::empty(); o.kind=OperationType::AppendToRegister;
+        o.c_target=BitId(bit); o.r_target=RegisterId(1); ops.insert(0,o);
+    }
+    // Conditions are snapshots, not references to a mutable classical slot.
+    let mut push=Op::empty(); push.kind=OperationType::PushCondition; push.c_condition=BitId(0);
+    let mut invert=Op::empty(); invert.kind=OperationType::BitInvert; invert.c_target=BitId(0);
+    let mut h=Op::empty(); h.kind=OperationType::Hmr; h.q_target=QubitId(12); h.c_target=BitId(1);
+    let mut ccx=gate(OperationType::CCX,12,18,19); ccx.c_condition=BitId(1);
+    let mut pop=Op::empty(); pop.kind=OperationType::PopCondition;
+    ops.extend([push,invert,h,ccx,pop]);
+    let reduced=simplify_products(ops.clone());
+    for input in 0..512 {
+        let mut ra=Fixed; let mut rb=Fixed;
+        let mut a=Simulator::new(20,2,&mut ra); let mut b=Simulator::new(20,2,&mut rb);
+        for q in 0..7 { a.qubits[q]=(input>>q)&1; }
+        for bit in 0..2 { a.bits[bit]=(input>>(7+bit))&1; }
+        b.qubits.clone_from(&a.qubits); b.bits.clone_from(&a.bits);
+        a.apply_iter(ops.iter()); b.apply_iter(reduced.iter());
+        assert_eq!(a.qubits,b.qubits); assert_eq!(a.bits,b.bits); assert_eq!(a.phase,b.phase);
+    }
+}
