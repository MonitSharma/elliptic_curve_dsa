+use crate::sim::Simulator;
+use sha3::digest::XofReader;
+#[path="product_h45_phase_kernel.rs"] mod kernel;
+
+fn scramble(mut z:u64)->u64 {z=(z^(z>>30)).wrapping_mul(0xbf58476d1ce4e5b9);z=(z^(z>>27)).wrapping_mul(0x94d049bb133111eb);z^(z>>31)}
+struct Tape {seed:u64,at:u64}
+impl XofReader for Tape {fn read(&mut self,o:&mut[u8]){assert_eq!(o.len(),8);let z=match self.seed {0=>0,1=>u64::MAX,s=>scramble(s^self.at.wrapping_mul(0x9e3779b97f4a7c15))};self.at+=1;o.copy_from_slice(&z.to_le_bytes());}}
+fn prepare(){crate::point_add::clear_process_env();crate::point_add::install_skywalk_submission_recipe();std::env::set_var("EXACT_PAIR_CARRY","1");crate::point_add::leapfrog::install_recipe();}
+// Arithmetic reference uses a complete integer low-word addition rather than
+// any constructor gate, majority formula, netlist or resynthesis coordinates.
+fn reference(x:u64,e:u64,n:u64,s:u64,mw:usize)->u64 {
+ let r=n+(x&7);let low=(x&63)+e+((r&1)<<4)+(((r^(r>>1))&1)<<5);
+ let y=((s!=0)as u64)*(low>>3&1)+2*(s>>1&1)*(low>>4&1)+4*((s&1)&(s>>1&1))*(low>>5&1);
+ let borrow=((x&7)+e>=8)as i128;let k=r as i128+8*(y as i128-borrow);
+ ((x as i128+e as i128-((1i128<<32)+976)*k)&((1i128<<mw)-1))as u64
+}
+fn circuit(mw:usize,room:usize,on:bool,nested:bool)->(Vec<Op>,Vec<QubitId>,[QubitId;8]){
+ crate::point_add::pingpong::with_phase_cap(Some(1234),||circuit_under_cap(mw,room,on,nested))
+}
+fn circuit_under_cap(mw:usize,room:usize,on:bool,nested:bool)->(Vec<Op>,Vec<QubitId>,[QubitId;8]){
+ let mut c=Builder::new();let abi=c.alloc_qubits(512);let classical=c.alloc_bits(512);let acc=c.alloc_qubits(mw);let d:[QubitId;8]=c.alloc_qubits(8).try_into().unwrap();
+ let one=nested.then(||c.alloc_bit());if let Some(one)=one{c.bit_store1(one);}
+ let _padding=c.alloc_qubits(cells::cap()-(512+mw+8+30+room));let active=c.active_qubits();
+ if nested {c.push_condition(classical[0]);c.bit_xor_into(classical[0],one.unwrap());c.push_condition(classical[1]);c.bit_xor_into(classical[1],one.unwrap());}
+ let prior=TOFFOLI_CARRY_CLEANUP_MODE.with(|x|x.replace(on));let at=PAYLOAD_AT.with(|x|x.replace(Some((false,if on{128}else{0}))));TOFFOLI_CARRY_CLEANUP_HITS.with(|x|x.set(0));
+ fold_fwd_v2(&mut c,&acc,[d[0],d[1],d[2]],[d[3],d[4],d[5]],d[6],d[7],0,None,false,0);
+ assert_eq!(TOFFOLI_CARRY_CLEANUP_HITS.with(|x|x.get()),usize::from(on));TOFFOLI_CARRY_CLEANUP_MODE.with(|x|x.set(prior));PAYLOAD_AT.with(|x|x.set(at));
+ if nested {c.bit_xor_into(classical[1],one.unwrap());c.pop_condition();c.bit_xor_into(classical[0],one.unwrap());c.pop_condition();}
+ if let Some(one)=one{c.bit_store0(one);c.free_bit(one);}
+ assert_eq!(c.active_qubits(),active);c.declare_qubit_register(&abi);c.declare_qubit_register(&acc);c.declare_bit_register(&classical);
+ (c.take_ops(),acc,d)
+}
+fn input(ops:&[Op],acc:&[QubitId],d:&[QubitId;8],base:usize,high:u64,nested:bool)->(Vec<u64>,Vec<u64>,Vec<u64>){
+ let(nq,nb,_,_)=analyze_ops(ops.iter());let mut q=vec![0u64;nq as usize];let mut b=vec![0u64;nb as usize];
+ // Every allocated passenger remains dirty and every temporary starts zero.
+ let owned:std::collections::HashSet<u64>=acc.iter().chain(d).map(|q|q.0).collect();
+ let mut touched=std::collections::HashSet::new();for o in ops {for id in [o.q_target,o.q_control1,o.q_control2]{if id.0!=u64::MAX{touched.insert(id.0);}}}
+ for i in 0..q.len(){if i<512||(!owned.contains(&(i as u64))&&!touched.contains(&(i as u64))){q[i]=scramble(i as u64^0x83721864ab59cdef);}}
