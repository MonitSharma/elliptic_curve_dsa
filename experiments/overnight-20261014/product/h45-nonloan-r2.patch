+  for(i,id)in acc.iter().enumerate(){q[id.0 as usize]|=(x>>i&1)<<lane;expected[id.0 as usize]|=(want>>i&1)<<lane;}
+  for(i,id)in d.iter().enumerate(){let v=(raw>>(i+6)&1)<<lane;q[id.0 as usize]|=v;expected[id.0 as usize]|=v;}
+ }
+ (q,b,expected)
+}
