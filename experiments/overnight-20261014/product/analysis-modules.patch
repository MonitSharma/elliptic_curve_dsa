+//! Cancel identical unconditional CCX gates through a proven commuting window.
+//! Controls must retain their physical values, and no intervening operation
+//! may read the target. X-type writes to that target commute; phase gates on
+//! the controls commute too. Measurements, resets, swaps and annotations are
+//! barriers when they touch any relevant wire. No operations are reordered.
+use crate::circuit::{Op,OperationType as K,NO_BIT,NO_QUBIT};
+use std::collections::HashMap;
+#[derive(Clone,Copy)]
+struct Pending{at:usize,ea:u64,eb:u64,reads:u64}
+pub(crate) fn simplify(ops:Vec<Op>)->Vec<Op>{
+ let nq=ops.iter().flat_map(|o|[o.q_control1,o.q_control2,o.q_target]).filter(|q|*q!=NO_QUBIT).map(|q|q.0 as usize+1).max().unwrap_or(0);
+ let mut epoch=vec![0u64;nq];let mut reads=vec![0u64;nq];let mut pending=HashMap::new();let mut drop=vec![false;ops.len()];let mut depth=0;let mut pairs=0;
+ for (at,o) in ops.iter().enumerate(){
+  if o.kind==K::PushCondition{depth+=1;continue;}if o.kind==K::PopCondition{depth-=1;continue;}
+  if o.kind==K::CCX&&depth==0&&o.c_condition==NO_BIT {
+   let t=o.q_target.0 as usize;let mut a=o.q_control1.0 as usize;let mut b=o.q_control2.0 as usize;if a>b{std::mem::swap(&mut a,&mut b);}
+   let key=(t,a,b);let old=pending.get(&key).copied();
+   if let Some(Pending{at:first,ea,eb,reads:seen})=old.filter(|p:&Pending|p.ea==epoch[a]&&p.eb==epoch[b]&&p.reads==reads[t]){
+    let _=(ea,eb,seen);drop[first]=true;drop[at]=true;pending.remove(&key);pairs+=1;
+   }else{if pending.len()>=200_000{pending.clear();}pending.insert(key,Pending{at,ea:epoch[a],eb:epoch[b],reads:reads[t]});}
+  }
+  let mut read=Vec::new();let mut write=Vec::new();
+  match o.kind {
+   K::X=>write.push(o.q_target),
+   K::CX=>{read.push(o.q_control1);write.push(o.q_target);},
+   K::CCX=>{read.extend([o.q_control1,o.q_control2]);write.push(o.q_target);},
+   K::Z=>read.push(o.q_target),K::CZ=>read.extend([o.q_control1,o.q_target]),
+   K::CCZ=>read.extend([o.q_control1,o.q_control2,o.q_target]),
+   K::Hmr|K::R=>{read.push(o.q_target);write.push(o.q_target);},
+   K::Swap=>{read.extend([o.q_control1,o.q_target]);write.extend([o.q_control1,o.q_target]);},
+   K::AppendToRegister|K::DebugPrint=>read.extend([o.q_control1,o.q_control2,o.q_target]),
+   _=>{}
+  }
+  for q in read{if q!=NO_QUBIT{reads[q.0 as usize]+=1;}}
+  for q in write{if q!=NO_QUBIT{epoch[q.0 as usize]+=1;}}
+ }
+ eprintln!("COMMUTE_CANCEL pairs={pairs} emitted_saving={} expected_saving={} (unconditional only)",2*pairs,2*pairs);
+ ops.into_iter().enumerate().filter_map(|(i,o)|(!drop[i]).then_some(o)).collect()
+}
