+/// K-lane restoring reciprocal with saved overflow and a zero comparator carry-in.
+pub fn stage1_v_compact(b: &mut B, zh: &[QubitId], win: &[QubitId], sz: &[QubitId], szr: (usize, usize), s: &S1, act: QubitId,
+                window: bool) -> Vec<G> {
+    let k = zh.len();
+    assert_eq!(s.r.len(), k);
+    assert_eq!(win.len(), TC + 1);
+    assert!(szr.1 <= 256 && szr.0 >= k + 33, "all-ones dividend needs s = sz - K >= 33");
+    b.begin();
+    let mut r = s.r.clone();
+    for &x in &r[..k - 1] { b.x(x); }
+    for j in 0..TC {
+        // Save overflow before rotating a k-bit remainder. Erase the old
+        // high bit from its new low position. The odd-divisor comparator
+        // requires a ZERO carry-in; append the dividend one after it.
+        b.cx(r[k - 1], s.f);
+        let top = r.pop().unwrap();
+        r.insert(0, top);
+        b.cx(s.f, r[0]);
+        // Overflow and low-word >= D cannot both hold when R < D.
+        // Their XOR is the full quotient decision. D's low bit is one.
+        if s.r.contains(&zh[k - 1]) {
+            super::frogdrop::cmp_csub_carries_vh1(b, &r[1..], &zh[1..k - 1], r[0], s.f);
+        } else {
+            cmp_csub_carries(b, &r[1..], &zh[1..], r[0], s.f, &s.andc);
+        }
+        b.x(r[0]);
+        b.cx(s.f, r[0]);
+        b.cx(r[0], s.f);
+        b.x(s.f);
+        if !window { continue; }
+        // V += act !f 2^(256 - sz - j) where that position is >= 0 (sz <= 256 - j)
+        let bits: Vec<QubitId> = (1..=1 + j).rev().map(|i| win[i]).collect();
+        let g0 = s.gt[0];
+        if szr.1 + j >= 257 {
+            let rr = super::frogdrop_col::rec(b, |b| {
+                super::frogdrop_col::ge_const_compact(b, sz, 257 - j as isize, g0, &s.chain, &s.dirty)
+            });
+            b.play(&rr, false);
+            if s.gt.len() == 1 {
+                inc_with_controls(b, &bits, &[(act, false), (r[0], false), (g0, true)], &s.dirty);
+            } else if s.gt.len() >= 3 {
+                let g1 = s.gt[1];
+                let g2 = s.gt[2];
+                b.x(g0);
+                b.and_c(act, g0, g2);
+                b.and_c(r[0], g2, g1);
+                inc_mixed(b, g1, &bits, &s.anc, &s.dirty);
+                b.and_u(r[0], g2, g1);
+                b.and_u(act, g0, g2);
+                b.x(g0);
+            } else {
+                let g1 = s.gt[1];
+                // g1 = act & r0 & !g0 (dirty three-control toggles)
+                mc_xor(b, &[(act, false), (r[0], false), (g0, true)], g1, &[], &s.dirty);
+                inc_mixed(b, g1, &bits, &s.anc, &s.dirty);
+                mc_xor(b, &[(act, false), (r[0], false), (g0, true)], g1, &[], &s.dirty);
+            }
+            b.play(&rr, true);
+        } else if s.gt.len() == 1 {
+            inc_with_controls(b, &bits, &[(act, false), (r[0], false)], &s.dirty);
+        } else {
+            let g1 = s.gt[1];
+            b.and_c(r[0], act, g1);
+            inc_mixed(b, g1, &bits, &s.anc, &s.dirty);
+            b.and_u(r[0], act, g1);
+        }
+    }
+    b.end()
