+#[cfg(test)]mod prefix27_full_fold_tests{
+ use super::*;use crate::circuit::{analyze_ops,Op,BitId,OperationType as K};use crate::sim::Simulator;use sha3::{Shake256,digest::{Update,ExtendableOutput,XofReader}};
+ struct Words{bytes:Vec<u8>,at:usize}impl XofReader for Words{fn read(&mut self,out:&mut[u8]){out.copy_from_slice(&self.bytes[self.at..self.at+out.len()]);self.at+=out.len();}}
+ fn circuit(room:usize,new:bool)->(Vec<Op>,Vec<QubitId>,BitId,u32){let mut c=Builder::new();let acc=c.alloc_qubits(56);let e=c.alloc_qubits(3);let nm=c.alloc_qubits(3);let k1=c.alloc_qubit();let k2=c.alloc_qubit();let guard=c.alloc_bit();let padding=c.alloc_qubits(1233-room-64);let input:Vec<_>=acc.iter().chain(&e).chain(&nm).copied().chain([k1,k2]).collect();let all:Vec<_>=input.iter().chain(&padding).copied().collect();c.declare_qubit_register(&all);c.push_condition(guard);let(_,peak)=super::super::super::super::pingpong::with_phase_cap(Some(if new{1233}else{1250}),||c.r3_peak(|c|{if new{full_fold(c,&acc,[e[0],e[1],e[2]],[nm[0],nm[1],nm[2]],k1,k2,1233);}else{fold_fwd_v2(c,&acc,[e[0],e[1],e[2]],[nm[0],nm[1],nm[2]],k1,k2,0,None,false,2);}}));c.pop_condition();assert_eq!(c.active_qubits(),all.len()as u32);assert!(peak<=if new{1233}else{1250});(c.take_ops(),input,guard,peak)}
+ #[test]fn complete_fold_matches_reference_all_small_inputs_with_independent_upper_words_and_tight_budgets(){
+  for room in[28,29,30,31,33,35]{let old=circuit(room,false);let new=circuit(room,true);assert_eq!(old.1,new.1);let(nq,nb,_,_)=analyze_ops(old.0.iter().chain(&new.0));let mut counts=[0u64;2];for condition in[0,0xa55a_dd33_ff00_1701,u64::MAX]{for batch in 0..256{let mut initial=vec![0;nq as usize];let mut h=Shake256::default();h.update(b"prefix27-full-fold-upper-v1");h.update(&(batch as u64).to_le_bytes());let mut reader=h.finalize_xof();for &q in &old.1[6..56]{let mut word=[0;8];reader.read(&mut word);initial[q.0 as usize]=u64::from_le_bytes(word);}let core:Vec<_>=old.1[..6].iter().chain(&old.1[56..]).copied().collect();for lane in 0..64{let value=batch*64+lane;for(i,&q)in core.iter().enumerate(){initial[q.0 as usize]|=((value>>i&1)as u64)<<lane;}}for mode in 0..3{let mut results=vec![];for(index,item)in[&old,&new].into_iter().enumerate(){let draws=item.0.iter().filter(|o|matches!(o.kind,K::Hmr|K::R)).count();let mut bytes=vec![0;draws*8];if mode==1{bytes.fill(255);}else if mode==2{let mut h=Shake256::default();h.update(b"prefix27-full-fold-measurements-v1");h.update(&(batch as u64).to_le_bytes());h.finalize_xof().read(&mut bytes);}let mut rng=Words{bytes,at:0};let mut s=Simulator::new(nq as usize,nb as usize,&mut rng);s.qubits.clone_from(&initial);s.bits[item.2.0 as usize]=condition;s.apply_iter(item.0.iter());assert_eq!(s.phase,0,"room{room} new{} batch{batch} mode{mode}",index==1);for q in 0..nq as usize{if !item.1[..56].iter().any(|w|w.0 as usize==q){assert_eq!(s.qubits[q],initial[q]);}}counts[index]+=s.stats.toffoli_gates;results.push(s.qubits.clone());drop(s);assert_eq!(rng.at,draws*8);}assert_eq!(results[0],results[1],"room{room} batch{batch} mode{mode}");}}}eprintln!("PREFIX27_FULL_FOLD room{room} old_peak{} new_peak{} old_executed{} new_executed{} diagnostic_only=1",old.3,new.3,counts[0],counts[1]);}
+ }
