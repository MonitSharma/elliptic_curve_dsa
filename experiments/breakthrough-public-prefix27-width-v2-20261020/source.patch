+#[cfg(test)]mod prefix_schedule_cleanup_tests{
+ use super::*;use crate::circuit::{analyze_ops,OperationType as K};use crate::sim::Simulator;use sha3::{Shake256,digest::{Update,ExtendableOutput,XofReader}};
+ struct Words{bytes:Vec<u8>,at:usize}impl XofReader for Words{fn read(&mut self,out:&mut[u8]){out.copy_from_slice(&self.bytes[self.at..self.at+out.len()]);self.at+=out.len();}}
+ #[test]fn prefix_and_cleanup_write_only_low_sums_for_all_inputs_guards_and42_measurement_coefficients(){
+  let mut c=Builder::new();let input=c.alloc_qubits(14);let guard=c.alloc_bit();c.push_condition(guard);let(_,peak)=c.r3_peak(|c|{let held=build(c,&input);finish(c,&input,&held);});c.pop_condition();assert_eq!(peak,41);assert_eq!(c.active_qubits(),14);c.declare_qubit_register(&input);let ops=c.take_ops();let(nq,nb,_,_)=analyze_ops(ops.iter());assert_eq!(nq,41);assert_eq!(ops.iter().filter(|o|o.kind==K::CCX).count(),44);assert_eq!(ops.iter().filter(|o|o.kind==K::Hmr).count(),42);assert!(!ops.iter().any(|o|o.kind==K::CCZ));let mut words=include_str!("prefix_schedule_expected.dat").split_whitespace().map(|x|x.parse::<u64>().unwrap());assert_eq!(words.next(),Some(34));assert_eq!(words.next(),Some(256));let exp:Vec<Vec<_>>=(0..14).map(|_|(0..256).map(|_|words.next().unwrap()).collect()).collect();
+  for condition in[0,0xa55a_dd33_ff00_1701,u64::MAX]{for batch in 0..256{for mode in 0..46{let mut bytes=vec![0;42*8];match mode{0=>{},1=>bytes.fill(255),2=>bytes.fill(0xa5),3=>{let mut h=Shake256::default();h.update(b"prefix27-complete-cleanup-coefficients-v1");h.update(&(batch as u64).to_le_bytes());h.finalize_xof().read(&mut bytes);},i=>bytes[(i-4)*8..(i-3)*8].fill(255)}let mut rng=Words{bytes,at:0};let mut s=Simulator::new(nq as usize,nb as usize,&mut rng);for lane in 0..64{let value=batch*64+lane;for(i,&q)in input.iter().enumerate(){s.qubits[q.0 as usize]|=((value>>i&1)as u64)<<lane;}}let initial=s.qubits.clone();s.bits[guard.0 as usize]=condition;s.apply_iter(ops.iter());assert_eq!(s.phase,0,"batch{batch} mode{mode} guard{condition}");for(i,&q)in input.iter().enumerate(){assert_eq!(s.qubits[q.0 as usize],(exp[i][batch]&condition)|(initial[q.0 as usize]&!condition));}for q in 14..nq as usize{assert_eq!(s.qubits[q],0);}assert_eq!(s.stats.toffoli_gates,44*u64::from(condition.count_ones()));drop(s);assert_eq!(rng.at,42*8);}}}
+ }
